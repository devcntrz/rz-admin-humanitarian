# Database
DATABASE_URL="postgresql://username:password@localhost:5432/rz_admin"
# Optional: neon | pg (app runtime in lib/db.ts; Drizzle migrate/seed always use pg)
# DB_CLIENT="pg"
# Optional override for pnpm db:seed
# SEED_SQL_PATH="./drizzle/data/seed.sql"

# API Configuration
NEXT_PUBLIC_API_URL="http://localhost:3000/api"

# CORS Configuration
CORS_ORIGINS="http://localhost:3000,http://localhost:3001,capacitor://localhost,ionic://localhost"
ALLOW_ALL_ORIGINS="true"

# Google OAuth Configuration
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# JWT Configuration
JWT_SECRET="your-super-secret-jwt-key"

# Environment
NODE_ENV="development"

# Vercel Blob (upload API: POST /api/upload/blob)
BLOB_READ_WRITE_TOKEN=""

# PDF location map uses Yandex Static Maps by default (no API token needed).

